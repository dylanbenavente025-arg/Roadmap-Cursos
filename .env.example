# Copiar este archivo como .env (el .env real no se versiona).

# PostgreSQL (contenedor)
POSTGRES_USER=aprovecha
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=aprovechaelbug

# Backend: el host "postgres" es el nombre del servicio en docker-compose.yml
DATABASE_URL=postgresql+psycopg://aprovecha:cambiar@postgres:5432/aprovechaelbug

# Puertos publicados en tu máquina (cambialos si alguno ya está ocupado)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173